      }
    },
    "Nie deinen Namen, dein Gewicht, deinen Körper oder Gesundheitsdaten. Deine Rekorde zählen nur ohne Namen in „Stärker als … %“." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never your name, your weight, your body or health data. Your records only count without a name in “Stronger than … %”."
          }
        }
      }
    },
    "Nie deinen Namen, dein Gewicht, deinen Körper oder andere Gesundheitsdaten. Deine Rekorde zählen nur ohne Namen in „Stärker als … %“." : {
      "localizations" : {
