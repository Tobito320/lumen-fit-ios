    },
    "Du kannst das jederzeit ändern: Profil, Präferenzen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this anytime: Profile, Preferences."
          }
        }
      }
    },
    "Du kannst den Bildschirm verlassen, es läuft weiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can leave the screen, it keeps running."
          }
        }
      }
    },
    "Du kannst jederzeit unter Profil, Über Lumen Fit, Datenschutz ausschalten. Die App funktioniert bei Nein genauso, auch mit Health." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn this off anytime under Profile, About Lumen Fit, Privacy. If you say no, the app works the same, including with Health."
