    "Du bist schon in zehn laufenden Herausforderungen, oder es waren zu viele Versuche. Warte eine Minute." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're already in ten running challenges, or there were too many attempts. Wait a minute."
