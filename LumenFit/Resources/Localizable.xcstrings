    },
    "Lumen Fit verbindet sich von selbst wieder, auch im Hintergrund, sobald das Band sendet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumen Fit reconnects by itself, also in the background, as soon as the band sends."
