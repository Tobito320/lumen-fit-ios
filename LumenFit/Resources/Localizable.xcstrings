    "Runder Rücken beim Hochziehen: das ist die größte Gefahr für die Wirbelsäule." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounded back while pulling up: that is the biggest risk for your spine."
          }
        }
      }
    },
    "Runder Rücken oder Aufrichten mit Schwung bei jeder Wiederholung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounded back or swinging upright on every rep."
          }
        }
      }
    },
