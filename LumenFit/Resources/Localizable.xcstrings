    "Brust an das Polster oder gerader Rücken, Schulterblätter zusammen ziehen, Ellbogen nah am Körper nach hinten, kurz halten, langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest against the pad or back straight, pull your shoulder blades together, elbows close to the body going back, hold briefly, return slowly."
          }
        }
      }
    },
    "Brust an das Polster, Griffe auf Schulterhöhe, Arme leicht gebeugt. Arme im Bogen nach hinten öffnen, bis sie in Linie mit dem Körper sind, und langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest against the pad, handles at shoulder height, arms slightly bent. Open your arms back in an arc until they're in line with your body, then return slowly."
          }
        }
      }
    },
    "Brust und Schulter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest and shoulders"
          }
        }
      }
    },
    "Bäuchlings hinlegen, Knie knapp hinter dem Polsterende, Polster über den Fersen. Fersen Richtung Po ziehen, kurz halten und langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lie face down, knees just behind the end of the pad, pad above your heels. Pull your heels toward your glutes, hold briefly and return slowly."
          }
        }
      }
    },
