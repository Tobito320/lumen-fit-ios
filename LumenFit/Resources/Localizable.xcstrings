    "Für deinen Tagesbogen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your daily arc"
          }
        }
      }
    },
    "Für den Puls im Training, wenn eine Uhr ihn misst." : {
