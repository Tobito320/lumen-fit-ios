            "value" : "Remove from favorites"
          }
        }
      }
    },
    "Aus: Lumen Fit hält keine Verbindung offen, bis du auf Verbinden tippst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: Lumen Fit keeps no connection open until you tap Connect."
          }
        }
      }
    },
    "Aus: der Haken setzt nur den Satz. An: nach jedem Satz läuft die Pause der Übung (Standard 2:00), am Ende Haptik und Band." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: the checkmark only completes the set. On: after each set the exercise's rest timer runs (default 2:00), with haptics and band at the end."
          }
        }
      }
    },
