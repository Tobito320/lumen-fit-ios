    "Deine HRV liegt nah an deinem Schnitt. Ein ganz normaler Tag." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV is close to your average. A perfectly normal day."
