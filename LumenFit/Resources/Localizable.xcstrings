    "Du hast zugestimmt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You agreed."
          }
        }
      }
    },
    "Du kannst das auch später ändern: Einstellungen, Health, Datenzugriff und Geräte, Lumen Fit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this later too: Settings, Health, Data Access and Devices, Lumen Fit."
