      }
    },
    "Sparmodus" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power saving"
          }
        }
      }
    },
    "Spart Akku am Tracker (der Sensor misst seltener) und am iPhone (weniger Abfragen). Wie viel, ist noch nicht gemessen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves battery on the tracker (the sensor measures less often) and on the iPhone (fewer requests). How much has not been measured yet."
          }
        }
      }
    },
    "Speichere zum Beispiel Haferflocken, Milch und Honig als eine Mahlzeit und trag sie mit einem Plus ein." : {
