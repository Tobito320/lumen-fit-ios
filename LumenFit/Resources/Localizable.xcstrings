    "Schulter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder"
          }
        }
      }
    },
    "Schulterblätter zusammen und runter, Füße fest am Boden. Stange zur unteren Brust senken, Ellbogen etwa 45 bis 60 Grad vom Körper, dann hochdrücken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder blades together and down, feet firmly on the floor. Lower the bar to your lower chest, elbows about 45 to 60 degrees from your body, then press up."
          }
        }
      }
    },
    "Schulterblätter zusammen und runter, Rücken leicht im Hohlkreuz, Füße fest am Boden. Stange oder Hanteln zur oberen Brust senken, Ellbogen etwa 45 bis 60 Grad vom Körper, dann hochdrücken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulder blades together and down, back slightly arched, feet firmly on the floor. Lower the bar or dumbbells to your upper chest, elbows about 45 to 60 degrees from your body, then press up."
          }
        }
      }
    },
    "Schultern" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders"
          }
        }
      }
    },
    "Schultern rollen nach vorn und lösen sich von der Lehne: die Brust arbeitet dann weniger." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders roll forward and come off the pad: your chest then works less."
          }
        }
      }
    },
    "Schultern unter die Polster, Fußballen auf die Kante, Fersen frei. Fersen tief senken, bis die Wade dehnt, und so hoch wie möglich auf die Zehen drücken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders under the pads, balls of your feet on the edge, heels free. Lower your heels deep until your calf stretches, then push up onto your toes as high as you can."
          }
        }
      }
    },
    "Schwach" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weak"
          }
        }
      }
    },
    "Schwer" : {
      "localizations" : {
