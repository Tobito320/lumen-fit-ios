        }
      }
    },
    "An 1 Tag pro Woche höchstens 500 kcal (Frau) bzw. 600 kcal (Mann), an den restlichen 6 Tagen normal essen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On 1 day per week at most 500 kcal (women) or 600 kcal (men), eat normally on the other 6 days."
          }
        }
      }
    },
    "An 2 Tagen pro Woche höchstens 500 kcal (Frau) bzw. 600 kcal (Mann), an den restlichen 5 Tagen normal essen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On 2 days per week at most 500 kcal (women) or 600 kcal (men), eat normally on the other 5 days."
          }
        }
      }
    },
    "An Gym-Tagen trinkst du %@ Gläser mehr als an Ruhetagen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On gym days you drink %@ more glasses than on rest days."
          }
