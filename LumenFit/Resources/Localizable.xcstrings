    "Rücken" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        }
      }
    },
    "Rücken an die Lehne, Griffe auf Schulterhöhe greifen, nach oben drücken, Nacken lang lassen, langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back against the pad, grip the handles at shoulder height, press up, keep your neck long, return slowly."
          }
        }
      }
    },
    "Rücken an die Lehne, Knie an der Drehachse, Polster über den Knien fest. Unteres Polster mit den Fersen nach unten und hinten drücken und langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back against the pad, knees at the pivot, pad firm over the knees. Press the lower pad down and back with your heels, then return slowly."
          }
        }
      }
    },
    "Rücken an die Lehne, Knie in Höhe der Gelenkachse. Beine strecken, oben kurz halten, langsam zurück." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back against the pad, knees level with the pivot. Extend your legs, hold briefly at the top, return slowly."
          }
        }
      }
    },
    "Rücken fest an die Lehne, Schulterblätter zusammen. Griffe auf Brusthöhe nach vorn drücken, langsam zurückführen, Schultern bleiben unten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back firmly against the pad, shoulder blades together. Press the handles forward at chest height, bring them back slowly, keep your shoulders down."
          }
        }
      }
    },
    "Rücken rund machen, um tiefer zu kommen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rounding your back to get deeper."
          }
        }
      }
    },
