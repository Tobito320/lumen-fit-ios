          }
        }
      }
    },
    "Schwerstes Set je Woche, letzte 8 Wochen. Tippen für Kurve und Rekorde." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heaviest set per week, last 8 weeks. Tap for curve and records."
          }
        }
      }
    },
    "Schwingen statt heben: der Schwung macht die Arbeit." : {
      "localizations" : {
