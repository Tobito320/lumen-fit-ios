    "Ellbogen ganz zur Seite und Po hebt ab: das belastet die Schulter und den unteren Rücken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows all the way out and hips lift off: this strains the shoulder and lower back."
          }
        }
      }
    },
    "Ellbogen gehen weit auseinander." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows flare far apart."
          }
        }
      }
    },
    "Ellbogen lösen sich vom Körper und die Schulter drückt mit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows come away from the body and the shoulder pushes along."
          }
        }
      }
    },
    "Ellbogen stark beugen: dann wird es ein Trizeps-Pushdown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows bent too much: it turns into a triceps pushdown."
          }
        }
      }
    },
    "Ellbogen wandern nach vorn und hinten: die Oberarme sollen ruhig bleiben." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows drift forward and back: the upper arms should stay still."
          }
        }
      }
    },
    "Ellbogen wandern nach vorn: dann hilft die Schulter mit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows drift forward: then the shoulder helps."
          }
        }
      }
    },
    "Ellbogen weit nach außen und Hohlkreuz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows flared far out and lower back arched."
          }
        }
      }
    },
    "Ellbogen weit nach außen. Hintern hebt ab. Stange springt von der Brust." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows flared far out. Butt lifts off. Bar bounces off the chest."
          }
        }
      }
    },
    "Ellbogen zu tief: dann arbeitet vor allem der mittlere Rücken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbows too low: then mainly the mid back works."
